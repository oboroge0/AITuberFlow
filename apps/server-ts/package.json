{
  "name": "@aituber-flow/server",
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build --compile --target=bun src/index.ts --outfile=server",
    "build:desktop": "bun build --compile --target=bun src/index.ts --outfile=../desktop/src-tauri/binaries/server",
    "build:desktop-darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile=../desktop/src-tauri/binaries/server-aarch64-apple-darwin",
    "build:desktop-darwin-x64": "bun build --compile --target=bun-darwin-x64 src/index.ts --outfile=../desktop/src-tauri/binaries/server-x86_64-apple-darwin",
    "build:desktop-windows-x64": "bun build --compile --target=bun-windows-x64 src/index.ts --outfile=../desktop/src-tauri/binaries/server-x86_64-pc-windows-msvc.exe",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/zod-validator": "^0.4.0",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "obs-websocket-js": "^5.0.7",
    "openai": "^6.21.0",
    "tmi.js": "^1.8.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "bun-types": "^1.3.9",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0"
  }
}
