{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "ollama-llm",
  "name": "Ollama (Local)",
  "version": "1.0.0",
  "description": "Generate text using Ollama local LLM server. Supports various open-source models.",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "llm",
  "ui": {
    "label": "Ollama",
    "icon": "si:ollama",
    "color": "#5E81AC",
    "bgColor": "rgba(94, 129, 172, 0.15)",
    "statusText": "Model: Ollama"
  },
  "node": {
    "inputs": [
      {
        "id": "system",
        "type": "string",
        "description": "システムプロンプト（prompt-builderから）"
      },
      {
        "id": "prompt",
        "type": "string",
        "description": "モデルに送るメッセージ"
      }
    ],
    "outputs": [
      {
        "id": "response",
        "type": "string",
        "description": "モデルの応答テキスト"
      }
    ],
    "events": {
      "emits": [
        "response.generated"
      ],
      "listens": []
    }
  },
  "config": {
    "host": {
      "type": "string",
      "label": "Host",
      "description": "Ollama server URL",
      "default": "http://localhost:11434"
    },
    "model": {
      "type": "string",
      "label": "Model",
      "description": "Model name (e.g., llama3.2, mistral, gemma2)",
      "default": "llama3.2",
      "inline": true
    },
    "systemPrompt": {
      "type": "textarea",
      "label": "System Prompt",
      "description": "System instructions for the model",
      "default": "You are a helpful assistant."
    },
    "temperature": {
      "type": "number",
      "label": "Temperature",
      "description": "Sampling temperature (0-1)",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "inline": true
    },
    "maxTokens": {
      "type": "number",
      "label": "Max Tokens",
      "description": "Maximum number of tokens in the response",
      "default": 1024,
      "min": 1,
      "max": 4096
    },
    "contextLength": {
      "type": "number",
      "label": "Context Length",
      "description": "Maximum context window size",
      "default": 4096,
      "min": 512,
      "max": 32768
    }
  }
}