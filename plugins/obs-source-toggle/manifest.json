{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "obs-source-toggle",
  "name": "OBS Source Toggle",
  "version": "1.0.0",
  "description": "Show or hide OBS sources via WebSocket. Requires OBS Studio 28+ with WebSocket server enabled.",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "obs",
  "ui": {
    "label": "OBS Source Toggle",
    "icon": "Eye",
    "color": "#8B7CC4",
    "bgColor": "rgba(139, 124, 196, 0.15)",
    "statusText": "OBS Source Toggle"
  },
  "node": {
    "inputs": [
      {
        "id": "trigger",
        "type": "any",
        "description": "ソース表示切替のトリガー"
      },
      {
        "id": "visible",
        "type": "boolean",
        "description": "表示状態（true=表示、false=非表示）"
      }
    ],
    "outputs": [
      {
        "id": "success",
        "type": "boolean",
        "description": "操作の成否"
      },
      {
        "id": "visible",
        "type": "boolean",
        "description": "操作後の表示状態"
      },
      {
        "id": "sourceName",
        "type": "string",
        "description": "対象ソースの名前"
      }
    ],
    "events": {
      "emits": [],
      "listens": []
    }
  },
  "config": {
    "host": {
      "type": "string",
      "label": "Host",
      "description": "OBS WebSocket server host",
      "default": "localhost"
    },
    "port": {
      "type": "number",
      "label": "Port",
      "description": "OBS WebSocket server port",
      "default": 4455
    },
    "password": {
      "type": "string",
      "label": "Password",
      "description": "OBS WebSocket server password (leave empty if not set)",
      "default": ""
    },
    "sceneName": {
      "type": "string",
      "label": "Scene Name",
      "description": "Scene containing the source (leave empty for current scene)",
      "default": ""
    },
    "sourceName": {
      "type": "string",
      "label": "Source Name",
      "description": "Name of the source to toggle",
      "default": ""
    },
    "action": {
      "type": "select",
      "label": "Action",
      "description": "What to do with the source",
      "default": "toggle",
      "options": [
        {"label": "Toggle", "value": "toggle"},
        {"label": "Show", "value": "show"},
        {"label": "Hide", "value": "hide"}
      ]
    }
  }
}
