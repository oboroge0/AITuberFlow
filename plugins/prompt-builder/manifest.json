{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "prompt-builder",
  "name": "Prompt Builder",
  "version": "1.0.0",
  "description": "Build system prompts by combining static text and dynamic inputs from other nodes.",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "utility",
  "ui": {
    "label": "Prompt Builder",
    "icon": "FileText",
    "color": "#6366F1",
    "bgColor": "rgba(99, 102, 241, 0.1)"
  },
  "node": {
    "inputs": [],
    "outputs": [
      {
        "id": "system",
        "type": "string",
        "description": "組み立てたシステムプロンプト"
      }
    ],
    "events": {
      "emits": [],
      "listens": []
    }
  },
  "config": {
    "promptSections": {
      "type": "prompt-builder",
      "label": "Prompt Builder",
      "description": "テキストブロックと入力ポートを組み合わせてプロンプトを構築"
