{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "donation-alert",
  "name": "Donation Alert",
  "version": "1.0.0",
  "description": "Display visual and audio alerts for donations (Super Chat, Bits, etc.)",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "output",
  "ui": {
    "label": "Donation Alert",
    "icon": "Gift",
    "color": "#F59E0B",
    "bgColor": "rgba(245, 158, 11, 0.1)",
    "statusText": "Donation Alert"
  },
  "node": {
    "inputs": [
      {
        "id": "trigger",
        "type": "any",
        "description": "アラート表示のトリガー"
      },
      {
        "id": "amount",
        "type": "number",
        "description": "投げ銭の金額"
      },
      {
        "id": "currency",
        "type": "string",
        "description": "通貨コード（USD、JPYなど）"
      },
      {
        "id": "author",
        "type": "string",
        "description": "投げ銭した人の名前"
      },
      {
        "id": "message",
        "type": "string",
        "description": "投げ銭メッセージ"
      }
    ],
    "outputs": [
      {
        "id": "displayed",
        "type": "boolean",
        "description": "アラート表示済みならtrue"
      }
    ],
    "events": {
      "emits": [
        "donation.alert"
      ],
      "listens": []
    }
  },
  "config": {
    "alertSound": {
      "type": "string",
      "label": "Alert Sound URL",
      "description": "URL to the alert sound file (leave empty for no sound)",
      "default": ""
    },
    "displayDuration": {
      "type": "number",
      "label": "Display Duration (ms)",
      "description": "How long to show the alert",
      "default": 5000,
      "min": 1000,
      "max": 30000
    },
    "minAmount": {
      "type": "number",
      "label": "Minimum Amount",
      "description": "Minimum donation amount to trigger alert (0 = all)",
      "default": 0
    },
    "template": {
      "type": "string",
      "label": "Message Template",
      "description": "Template for the alert message. Use {author}, {amount}, {currency}, {message}",
      "default": "{author} donated {amount} {currency}!"
    },
    "style": {
      "type": "select",
      "label": "Alert Style",
      "description": "Visual style of the alert",
      "options": [
        "default",
        "minimal",
        "fancy"
      ],
      "default": "default"
    }
  }
}
