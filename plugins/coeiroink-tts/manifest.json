{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "coeiroink-tts",
  "name": "COEIROINK TTS",
  "version": "1.0.0",
  "description": "Text-to-speech using COEIROINK. Free Japanese voice synthesis engine.",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "tts",
  "ui": {
    "label": "COEIROINK",
    "icon": "Volume2",
    "color": "#E91E63",
    "bgColor": "rgba(233, 30, 99, 0.1)",
    "statusText": "Engine: COEIROINK"
  },
  "node": {
    "inputs": [
      {
        "id": "text",
        "type": "string",
        "description": "読み上げるテキスト"
      }
    ],
    "outputs": [
      {
        "id": "audio",
        "type": "audio",
        "description": "生成された音声ファイルのパス"
      },
      {
        "id": "audioUrl",
        "type": "string",
        "description": "音声ファイルのURL"
      },
      {
        "id": "filename",
        "type": "string",
        "description": "音声ファイル名"
      },
      {
        "id": "duration",
        "type": "number",
        "description": "音声の長さ（秒）"
      }
    ],
    "events": {
      "emits": ["audio.generated"],
      "listens": []
    }
  },
  "config": {
    "host": {
      "type": "string",
      "label": "Host",
      "description": "COEIROINK server URL",
      "default": "http://localhost:50032"
    },
    "speakerUuid": {
      "type": "string",
      "label": "Speaker UUID",
      "description": "Speaker UUID (get from COEIROINK)",
      "default": ""
    },
    "styleId": {
      "type": "number",
      "label": "Style ID",
      "description": "Voice style ID",
      "default": 0,
      "min": 0
    },
    "speedScale": {
      "type": "number",
      "label": "Speed",
      "description": "Speech speed (0.5-2.0)",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "inline": true
    },
    "volumeScale": {
      "type": "number",
      "label": "Volume",
      "description": "Volume scale (0.0-2.0)",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    },
    "pitchScale": {
      "type": "number",
      "label": "Pitch",
      "description": "Pitch scale (0.5-2.0)",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0
    },
    "demoMode": {
      "type": "boolean",
      "label": "Demo Mode",
      "label_ja": "デモモード",
      "description": "Skip TTS when COEIROINK is unavailable",
      "description_ja": "COEIROINK未接続時にスキップ",
      "default": false
    }
  }
}
