{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "avatar-configuration",
  "name": "Avatar Configuration",
  "version": "2.0.0",
  "description": "Static avatar configuration - sets VRM model, idle animation, and renderer type",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "avatar",
  "ui": {
    "label": "Avatar Config",
    "icon": "User",
    "color": "#E879F9",
    "bgColor": "rgba(232, 121, 249, 0.1)",
    "statusText": "Avatar Configuration"
  },
  "node": {
    "inputs": [],
    "outputs": [],
    "events": {
      "emits": [
        "avatar.update"
      ]
    }
  },
  "config": {
    "renderer": {
      "type": "select",
      "label": "Renderer",
      "description": "Avatar renderer type",
      "options": [
        {
          "label": "VRM (Built-in)",
          "value": "vrm"
        },
        {
          "label": "VTube Studio",
          "value": "vtube-studio"
        },
        {
          "label": "PNG Images",
          "value": "png"
        }
      ],
      "default": "vrm"
    },
    "modelUrl": {
      "type": "model-file",
      "label": "3D Model",
      "description": "URL or path to VRM model file",
      "default": "/models/Flowchan.vrm",
      "accept": ".vrm",
      "showWhen": { "key": "renderer", "value": "vrm" }
    },
    "idleAnimation": {
      "type": "animation-file",
      "label": "Idle Animation",
      "description": "Path to idle animation file (Mixamo FBX)",
      "default": "",
      "accept": ".fbx",
      "showWhen": { "key": "renderer", "value": "vrm" }
    },
    "vtubePort": {
      "type": "number",
      "label": "VTube Studio Port",
      "description": "Port for VTube Studio API connection",
      "default": 8001,
      "showWhen": { "key": "renderer", "value": "vtube-studio" }
    },
    "vtubeMouthParam": {
      "type": "string",
      "label": "VTS Mouth Parameter",
      "description": "VTube Studio parameter ID for mouth control (e.g., MouthOpen, MouthOpenY)",
      "default": "MouthOpen",
      "showWhen": { "key": "renderer", "value": "vtube-studio" }
    },
    "vtubeExpressionMap": {
      "type": "textarea",
      "label": "VTS Expression Hotkey Map (JSON)",
      "description": "Map expressions to VTube Studio hotkey IDs. Format: {\"happy\": \"HotkeyID\", ...}",
      "default": "{\"happy\": \"Happy\", \"sad\": \"Sad\", \"angry\": \"Angry\", \"surprised\": \"Surprised\", \"relaxed\": \"Relaxed\", \"neutral\": \"Neutral\"}",
      "showWhen": { "key": "renderer", "value": "vtube-studio" }
    },
    "pngConfig": {
      "type": "png-expression-map",
      "label": "PNG Expression Mapping",
      "description": "Configuration for PNG avatar expressions",
      "default": "{\"baseUrl\": \"/images/avatar/\", \"expressions\": {}}",
      "showWhen": { "key": "renderer", "value": "png" }
    }
  }
}
