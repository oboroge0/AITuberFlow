{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "switch",
  "name": "Switch",
  "version": "1.0.0",
  "description": "Conditional routing based on input values. Routes data to different outputs based on conditions.",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "control",
  "ui": {
    "label": "Switch",
    "icon": "GitBranch",
    "color": "#F97316",
    "bgColor": "rgba(249, 115, 22, 0.1)",
    "statusText": "Conditional routing"
  },
  "node": {
    "inputs": [
      {
        "id": "value",
        "type": "any",
        "description": "評価する値"
      },
      {
        "id": "data",
        "type": "any",
        "description": "パススルーするデータ"
      }
    ],
    "outputs": [
      {
        "id": "true",
        "type": "any",
        "description": "条件が真のときの出力"
      },
      {
        "id": "false",
        "type": "any",
        "description": "条件が偽のときの出力"
      },
      {
        "id": "match",
        "type": "any",
        "description": "値が一致したときの出力"
      }
    ],
    "events": {
      "emits": [],
      "listens": []
    }
  },
  "config": {
    "mode": {
      "type": "select",
      "label": "Mode",
      "description": "How to evaluate the condition",
      "default": "truthy",
      "options": [
        {"label": "Truthy/Falsy", "value": "truthy"},
        {"label": "Equals", "value": "equals"},
        {"label": "Contains", "value": "contains"},
        {"label": "Regex Match", "value": "regex"},
        {"label": "Greater Than", "value": "gt"},
        {"label": "Less Than", "value": "lt"}
      ]
    },
    "compareValue": {
      "type": "string",
      "label": "Compare Value",
      "description": "Value to compare against (for equals/contains/regex/gt/lt modes)",
      "default": ""
    },
    "caseSensitive": {
      "type": "boolean",
      "label": "Case Sensitive",
      "description": "Use case-sensitive comparison",
      "default": false
    }
  }
}
