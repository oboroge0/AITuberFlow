{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "http-request",
  "name": "HTTP Request",
  "version": "1.0.0",
  "description": "Make HTTP requests to external APIs. Supports GET, POST, PUT, DELETE methods.",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "utility",
  "ui": {
    "label": "HTTP Request",
    "icon": "Globe",
    "color": "#3B82F6",
    "bgColor": "rgba(59, 130, 246, 0.1)",
    "statusText": "HTTP Request"
  },
  "node": {
    "inputs": [
      {
        "id": "body",
        "type": "any",
        "description": "リクエストボディ（POST/PUT用）"
      }
    ],
    "outputs": [
      {
        "id": "response",
        "type": "any",
        "description": "APIからのレスポンスデータ"
      },
      {
        "id": "status",
        "type": "number",
        "description": "HTTPステータスコード"
      }
    ],
    "events": {
      "emits": [],
      "listens": []
    }
  },
  "config": {
    "url": {
      "type": "string",
      "label": "URL",
      "description": "The URL to send the request to",
      "default": ""
    },
    "method": {
      "type": "select",
      "label": "Method",
      "description": "HTTP method",
      "default": "GET",
      "options": ["GET", "POST", "PUT", "DELETE", "PATCH"]
    },
    "headers": {
      "type": "textarea",
      "label": "Headers (JSON)",
      "description": "Request headers as JSON",
      "default": "{}"
    },
    "timeout": {
      "type": "number",
      "label": "Timeout (ms)",
      "description": "Request timeout in milliseconds",
      "default": 30000,
      "min": 1000,
      "max": 120000
    },
    "allowPrivateHosts": {
      "type": "boolean",
      "label": "Allow Private / Loopback Hosts",
      "description": "Permit requests to localhost and RFC1918/link-local addresses. Disabled by default to mitigate SSRF.",
      "default": false
    },
    "maxRedirects": {
      "type": "number",
      "label": "Max Redirects",
      "description": "Maximum number of redirects to follow (0 disables redirects)",
      "default": 5,
      "min": 0,
      "max": 20
    },
    "maxResponseBytes": {
      "type": "number",
      "label": "Max Response Size (bytes)",
      "description": "Maximum allowed response body size in bytes",
      "default": 52428800,
      "min": 1024,
      "max": 1073741824
    }
  }
}
