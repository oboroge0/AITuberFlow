{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "audio-player",
  "name": "Audio Player",
  "version": "1.0.0",
  "description": "Plays audio files and emits playback events for synchronization",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "output",
  "ui": {
    "label": "Audio Player",
    "icon": "Volume2",
    "color": "#8B5CF6",
    "bgColor": "rgba(139, 92, 246, 0.1)",
    "statusText": "Audio Player"
  },
  "node": {
    "inputs": [
      {
        "id": "audio",
        "type": "audio",
        "description": "音声ファイルのパス"
      },
      {
        "id": "duration",
        "type": "number",
        "description": "音声の長さ（秒、省略可）"
      }
    ],
    "outputs": [],
    "events": {
      "emits": [
        "audio.play",
        "audio.stop"
      ]
    }
  },
  "config": {
    "waitForCompletion": {
      "type": "boolean",
      "label": "Wait for Completion",
      "description": "Wait until audio finishes playing before continuing workflow",
      "default": true
    },
    "volume": {
      "type": "number",
      "label": "Volume",
      "description": "Playback volume (0.0 - 1.0)",
      "default": 1,
      "min": 0,
      "max": 1,
      "inline": true
    },
    "outputDevice": {
      "type": "select",
      "label": "Output Device",
      "description": "Where to play the audio",
      "options": [
        {
          "label": "Browser (Frontend)",
          "value": "browser"
        },
        {
          "label": "Server (Local)",
          "value": "server"
        }
      ],
      "default": "browser"
    }
  }
}
