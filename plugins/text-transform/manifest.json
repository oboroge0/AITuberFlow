{
  "$schema": "https://aituber-flow.dev/schemas/plugin-manifest.json",
  "id": "text-transform",
  "name": "Text Transform",
  "version": "1.0.0",
  "description": "Transform text with various operations: uppercase, lowercase, trim, replace, template, etc.",
  "author": {
    "name": "AITuberFlow",
    "url": "https://github.com/oboroge0/AITuberFlow"
  },
  "license": "MIT",
  "category": "utility",
  "ui": {
    "label": "Text Transform",
    "icon": "CaseSensitive",
    "color": "#EC4899",
    "bgColor": "rgba(236, 72, 153, 0.1)",
    "statusText": "Text Transform"
  },
  "node": {
    "inputs": [
      {
        "id": "text",
        "type": "string",
        "description": "変換するテキスト"
      }
    ],
    "outputs": [
      {
        "id": "result",
        "type": "string",
        "description": "変換後のテキスト"
      }
    ],
    "events": {
      "emits": [],
      "listens": []
    }
  },
  "config": {
    "operation": {
      "type": "select",
      "label": "Operation",
      "description": "Transformation to apply",
      "default": "template",
      "inline": true,
      "options": ["template", "uppercase", "lowercase", "trim", "replace", "split_first", "split_last", "length", "prefix", "suffix"]
    },
    "template": {
      "type": "textarea",
      "label": "Template",
      "description": "Template string. Use {{text}} for input text.",
      "default": "{{text}}"
    },
    "templateInputs": {
      "type": "input-list",
      "label": "Template Inputs",
      "description": "Named input ports that become template variables (e.g., {{name}})",
      "showWhen": {
        "key": "operation",
        "value": "template"
      }
    },
    "find": {
      "type": "string",
      "label": "Find",
      "description": "Text to find (for replace operation)",
      "default": ""
    },
    "replaceWith": {
      "type": "string",
      "label": "Replace With",
      "description": "Text to replace with",
      "default": ""
    },
    "delimiter": {
      "type": "string",
      "label": "Delimiter",
      "description": "Delimiter for split operations",
      "default": " "
    }
  }
}
